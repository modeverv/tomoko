{
  "name": "real-overlap-stop",
  "description": "Real runtime: user overlaps Tomoko's reply with a stop intent; playback stops (PLAN S9 live).",
  "runtime": "real",
  "steps": [
    {
      "say": "トモコ、今日一日の過ごし方についてゆっくり長めに話して聞かせて",
      "wait_for": "tts_result",
      "wait_timeout_sec": 60.0,
      "expect": {
        "min_events": {"speech_order": 1}
      }
    },
    {
      "say": "もういいよ、ストップ",
      "overlap_during_playback": true,
      "wait_for": "speech_order",
      "wait_timeout_sec": 60.0,
      "expect": {
        "min_events": {"speech_order": 1},
        "speech_order_modes_includes": ["stop"]
      }
    }
  ],
  "expect": {
    "min_events": {"transcript": 2, "speech_order": 2},
    "speech_order_modes_includes": ["stop"],
    "forbid_events": ["prompt_error"]
  }
}
