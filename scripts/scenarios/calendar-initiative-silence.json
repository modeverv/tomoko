{
  "name": "calendar-initiative-silence",
  "description": "Fake calendar material is converted by the think helper into an initiative candidate without explicit fake_candidates.",
  "runtime": "any",
  "fake_reply": "そろそろ定例会議だよ。",
  "fake_calendar": [{"offset_min": 5, "title": "定例会議"}],
  "steps": [
    {
      "event": {"type": "initiative_tick"},
      "wait_for": "prompt_complete",
      "expect": {
        "min_events": {
          "initiative_tick_ack": 1,
          "scheduler_decision": 1,
          "speech_order": 1
        },
        "max_events": {"transcript": 0},
        "speech_order_modes": ["replace_current"],
        "speech_order_text_contains": "定例会議",
        "speech_order_reason_contains": "candidate pressure initiative tick",
        "score_breakdown_any": {
          "pressure_world_candidate_pressure": {"min": 0.7},
          "pressure_world_importance": {"min": 0.7},
          "pressure_world_deliverability": {"min": 0.9}
        }
      }
    }
  ],
  "expect": {
    "min_events": {
      "initiative_tick_ack": 1,
      "scheduler_decision": 1,
      "speech_order": 1,
      "binary_audio": 1,
      "prompt_complete": 1
    },
    "max_events": {"transcript": 0},
    "speech_order_modes": ["replace_current"],
    "speech_order_text_contains": "定例会議",
    "speech_order_reason_contains": "candidate pressure initiative tick",
    "score_breakdown_any": {
      "pressure_world_candidate_pressure": {"min": 0.7},
      "pressure_world_importance": {"min": 0.7},
      "pressure_world_deliverability": {"min": 0.9}
    },
    "forbid_events": ["prompt_error"]
  }
}
