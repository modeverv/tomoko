{
  "name": "user-status-absent-pressure",
  "description": "Absent user status suppresses spontaneous calendar followup while preserving the direct reply (Step 7).",
  "runtime": "any",
  "fake_reply": "今の作業、短く見るね。",
  "fake_transcript": "トモコ、今の作業どう思う",
  "fake_calendar": [{"offset_min": 5, "title": "定例会議"}],
  "fake_user_status": {
    "present": false,
    "activity_label": "away",
    "summary": "away: no user detected",
    "confidence": 0.95
  },
  "steps": [
    {
      "say": "トモコ、今の作業どう思う",
      "wait_for": "prompt_complete",
      "expect": {
        "min_events": {"scheduler_decision": 1, "speech_order": 1},
        "max_events": {"speech_order": 1},
        "speech_order_modes": ["replace_current"],
        "score_breakdown_any": {
          "pressure_world_user_presence": {"equals": 0.0},
          "pressure_world_user_absence": {"equals": 1.0},
          "pressure_world_urgency": {"equals": 0.0}
        }
      }
    }
  ],
  "expect": {
    "min_events": {
      "transcript": 1,
      "scheduler_decision": 1,
      "speech_order": 1,
      "binary_audio": 1,
      "prompt_complete": 1
    },
    "max_events": {"speech_order": 1},
    "speech_order_modes": ["replace_current"],
    "score_breakdown_any": {
      "pressure_world_user_presence": {"equals": 0.0},
      "pressure_world_user_absence": {"equals": 1.0},
      "pressure_world_urgency": {"equals": 0.0}
    },
    "forbid_events": ["prompt_error"]
  }
}
